FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y python3 python3-venv python3-pip nodejs npm curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . /app
RUN python3 -m venv backend/.venv && backend/.venv/bin/pip install -r backend/requirements.lock
RUN cd frontend && npm install && npm run build
RUN cd backend && PYTHONPATH=. .venv/bin/python -m compileall -q app && PYTHONPATH=. .venv/bin/pytest -q
CMD ["bash","-lc","cd backend && PYTHONPATH=. .venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000"]
